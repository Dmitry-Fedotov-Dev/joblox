# Скопируйте в deploy/.env и заполните. Файл .env в git не попадает.
DOMAIN=shop.example.com
JOBLOX_BASE_URL=https://shop.example.com
JOBLOX_ENV=prod
# openssl rand -hex 32
JOBLOX_SECRET=

# Почта для кодов и статусов (любой SMTP: Яндекс 360, Mail.ru для бизнеса, Brevo, Mailgun …)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Магазин <shop@example.com>

# Бот операторов: токен от @BotFather, id операторов через запятую (узнать: написать боту, он ответит id)
TELEGRAM_TOKEN=
JOBLOX_OPERATORS=

# Профиль бизнеса относительно папки deploy (по умолчанию пекарня)
PROFILE_FILE=../profiles/bakery.yaml
