# Установка без Docker: бинарник в /usr/local/bin, данные в /var/lib/openline, настройки в /etc/openline.
#   useradd --system --home /var/lib/openline --shell /usr/sbin/nologin openline
#   install -m 755 bin/openline /usr/local/bin/openline
#   install -d -o openline -m 750 /var/lib/openline /etc/openline
#   cp deploy/.env.example /etc/openline/env && chmod 600 /etc/openline/env   # и заполнить
#   systemctl enable --now openline
# HTTPS — Caddy на хосте: deploy/Caddyfile.host.
[Unit]
Description=OpenLine Shop
After=network-online.target
Wants=network-online.target

[Service]
User=openline
EnvironmentFile=/etc/openline/env
Environment=OPENLINE_DB=/var/lib/openline/openline.db
Environment=OPENLINE_ADDR=127.0.0.1:8080
Environment=OPENLINE_ADMIN_ADDR=127.0.0.1:9180
ExecStart=/usr/local/bin/openline serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/openline
MemoryMax=256M

[Install]
WantedBy=multi-user.target
